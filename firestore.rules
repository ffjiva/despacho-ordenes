rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    function isSuper() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.apps.despacho.role == 'super';
    }
    function isActive() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }

    // ── users/{uid} ───────────────────────────────────────
    match /users/{uid} {
      allow read:   if isAuth();
      allow create: if isAuth() && request.auth.uid == uid;
      allow update: if isSuper()
        || (request.auth.uid == uid &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['fcmTokens', 'name']));
      allow delete: if isSuper();
    }

    // ── despachos/{id} ────────────────────────────────────
    match /despachos/{id} {
      allow read: if isAuth() && isActive();

      // Solo super puede crear y eliminar
      allow create: if isSuper();
      allow delete: if isSuper();

      // Super puede actualizar cualquier campo
      // Collaborator solo puede actualizar checked{}, lockedBy, lockedAt, status
      allow update: if isSuper()
        || (isAuth() && isActive() &&
            resource.data.assignedTo == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['checked', 'lockedBy', 'lockedByName', 'lockedAt', 'status', 'startedAt', 'completedAt', 'dispatchedAt', 'incompleteItems', 'activeMs', 'archived', 'photos']));
    }

    // ── config/{doc} ─────────────────────────────────────
    match /config/{doc} {
      allow read:  if isAuth();
      allow write: if isSuper();
    }

    // ── reposiciones/{id} ────────────────────────────────
    match /reposiciones/{id} {
      allow read:  if isAuth();
      allow write: if isSuper();
    }

    // ── proyecciones/{id} ────────────────────────────────
    match /proyecciones/{id} {
      allow read:  if isAuth();
      allow write: if isSuper();
    }

    // ── vueltas y domicilios: requieren sesión (moto.html ya usa Auth) ──
    match /vueltas/{id} {
      allow read, write: if isAuth();
    }
    match /domicilios/{id} {
      allow read, write: if isAuth();
    }

    // ── ops_pendientes ───────────────────────────────────
    match /ops_pendientes/{id} {
      allow read, write: if isSuper();
    }

    // ── cierres ──────────────────────────────────────────
    match /cierres/{id} {
      allow read, write: if isSuper();
    }

    // ── agenda ───────────────────────────────────────────
    match /agenda/{id} {
      allow read, write: if isSuper();
    }

    // ── notificaciones ───────────────────────────────────
    match /notificaciones/{id} {
      allow read, write: if isAuth();
    }

    // ── inventarios ──────────────────────────────────────────
    match /inventarios/{invId} {
      allow read:           if isAuth();
      allow create, delete: if isSuper();
      // Super puede todo. El colaborador ASIGNADO guarda solo su avance de conteo:
      // no puede reasignarse, ni tocar metadatos, ni crear/borrar.
      allow update: if isSuper()
        || ( isAuth()
             && resource.data.asignadoA == request.auth.uid
             && request.resource.data.asignadoA == resource.data.asignadoA
             && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['productos', 'resumen', 'status', 'iniciadoAt', 'completadoAt']) );
    }

    // ── colaboradores ─────────────────────────────────────────
    match /colaboradores/{id} {
      allow read, write: if isSuper();
    }
  }
}
